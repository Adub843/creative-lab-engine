# /etc/lab/lab.env  (owner root, mode 600). Aaron types each value himself on the server:
#   sudo nano /etc/lab/lab.env
# Never paste these into chat, a repo, or any other file.
LAB_CONFIG=/etc/lab/lab.config.json
# Cloudflare API token limited to: Queues Edit + R2 Edit on Aaron's account (the engine's queue and buckets)
CF_API_TOKEN=
# Optional: Claude through the API (otherwise the Claude command line on Aaron's plan answers)
ANTHROPIC_API_KEY=
# Optional: Kittl's MCP sign-in token, if Kittl gives one for servers
KITTL_MCP_TOKEN=
# Made by `npm run agent-key -- stacy aaron db,assets` (lets Stacy's shifts use the Lab's data)
LAB_AGENT_KEY=
