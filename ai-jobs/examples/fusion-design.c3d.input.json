          "max": 250,
          "default": 60
        },
        "height": {
          "type": "number",
          "min": 5,
          "max": 250,
          "default": 40
        },
        "wall": {
          "type": "number",
          "min": 0.8,
          "max": 10,
          "default": 2
        },
        "corner": {
          "type": "number",
          "min": 0,
          "max": 30,
          "default": 4
        },
        "lid": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "plate": {
