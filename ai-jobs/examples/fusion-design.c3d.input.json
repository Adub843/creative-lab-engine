          "min": 1,
          "max": 20,
          "default": 3
        },
        "corner": {
          "type": "number",
          "min": 0,
          "max": 40,
          "default": 5
        },
        "textSize": {
          "type": "number",
          "min": 3,
          "max": 120,
          "default": 10
        },
        "textDepth": {
          "type": "number",
          "min": 0.4,
          "max": 10,
          "default": 1.2
        },
        "holes": {
          "type": "choice",
          "options": [
            "none",
