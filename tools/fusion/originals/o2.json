[-2.04,-0.48],[-1.92,-0.48],[-1.92,-1.38]],\"holes\":[]},{\"outer\":[[-1.192,-1.38],[-1.312,-1.38],[-1.312,-0.48],[-1.192,-0.48]],\"holes\":[]},{\"outer\":[[-0.84,0.62],[-0.72,0.62],[-0.72,-0.28],[-0.84,-0.28]],\"holes\":[]},{\"outer\":[[-0.04,-0.28],[-0.16,-0.28],[-0.16,0.62],[-0.04,0.62]],\"holes\":[]},{\"outer\":[[-2.888,0.22],[-3.008,0.22],[-3.008,1.12],[-2.888,1.12]],\"holes\":[]},{\"outer\":[[-2.28,0.22],[-2.28,1.12],[-2.16,1.12],[-2.16,0.22]],\"holes\":[]},{\"outer\":[[-2.04,0.22],[-2.04,1.12],[-1.92,1.12],[-1.92,0.22]],\"holes\":[]},{\"outer\":[[-1.192,0.22],[-1.312,0.22],[-1.312,1.12],[-1.192,1.12]],\"holes\":[]},{\"outer\":[[-1.06,1.26],[-3.14,1.26],[-3.14,1.36],[-1.06,1.36]],\"holes\":[]},{\"outer\":[[0.72,-1.68],[0.72,-0.78],[0.84,-0.78],[0.84,-1.68]],\"holes\":[]},{\"outer\":[[1.192,-0.18],[1.312,-0.18],[1.312,-1.08],[1.192,-1.08]],\"holes\":[]},{\"outer\":[[2.04,-1.08],[1.92,-1.08],[1.92,-0.18],[2.04,-0.18]],\"holes\":[]},{\"outer\":[[2.16,-1.08],[2.16,-0.18],[2.28,-0.18],[2.28,-1.08]],\"holes\":[]},{\"outer\":[[2.888,-0.18],[3.008,-0.18],[3.008,-1.08],[2.888,-1.08]],\"holes\":[]},{\"outer\":[[0.04,0.62],[0.16,0.62],[0.16,-0.28],[0.04,-0.28]],\"holes\":[]},{\"outer\":[[0.72,-0.28],[0.72,0.62],[0.84,0.62],[0.84,-0.28]],\"holes\":[]},{\"outer\":[[0.94,0.76],[-0.94,0.76],[-0.94,0.86],[0.94,0.86]],\"holes\":[]},{\"outer\":[[1.192,1.42],[1.312,1.42],[1.312,0.52],[1.192,0.52]],\"holes\":[]},{\"outer\":[[2.04,0.52],[1.92,0.52],[1.92,1.42],[2.04,1.42]],\"holes\":[]},{\"outer\":[[2.16,1.42],[2.28,1.42],[2.28,0.52],[2.16,0.52]],\"holes\":[]},{\"outer\":[[2.888,1.42],[3.008,1.42],[3.008,0.52],[2.888,0.52]],\"holes\":[]},{\"outer\":[[1.06,1.56],[1.06,1.66],[3.14,1.66],[3.14,1.56]],\"holes\":[]}]}]\n\n    def inside(pt, ring):\n        x, y = pt\n        c = False\n        j = len(ring) - 1\n        for i in range(len(ring)):\n            xi, yi = ring[i]\n            xj, yj = ring[j]\n            if (yi > y) != (yj > y) and x < (xj - xi) * (y - yi) / (yj - yi + 1e-12) + xi:\n                c = not c\n            j = i\n        return c\n\n    def solid_at(pt, polys):\n        return any(inside(pt, p[\"outer\"]) and not any(inside(pt, h) for h in p[\"holes\"]) for p in polys)\n\n    # A point inside a profile: its centroid when that is inside, else a point just beside one of its longest\n    # edges. A thin ring (a cookie-cutter wall) has its centroid in the empty middle, which looked like no solid.\n    def point_in(prof):\n        segs = []\n        for lp in prof.profileLoops:\n            for pc in lp.profileCurves:\n                g = pc.geometry\n                segs.append(((g.startPoint.x, g.startPoint.y), (g.endPoint.x, g.endPoint.y)))\n        def in_prof(x, y):\n            c = False\n            for (xi, yi), (xj, yj) in segs:\n                if (yi > y) != (yj > y) and x < (xj - xi) * (y - yi) / (yj - yi + 1e-12) + xi:\n                    c = not c\n            return c\n        cen = prof.areaProperties(adsk.fusion.CalculationAccuracy.MediumCalculationAccuracy).centroid\n        if in_prof(cen.x, cen.y):\n            return (cen.x, cen.y)\n        for (xi, yi), (xj, yj) in sorted(segs, key=lambda s: -((s[1][0] - s[0][0]) ** 2 + (s[1][1] - s[0][1]) ** 2))[:20]:\n            mx, my, dx, dy = (xi + xj) / 2, (yi + yj) / 2, xj - xi, yj - yi\n            ln = (dx * dx + dy * dy) ** 0.5 or 1\n            for d in (0.001, 0.0002):\n                for sgn in (1, -1):\n                    x, y = mx - sgn * d * dy / ln, my + sgn * d * dx / ln\n                    if in_prof(x, y):\n                        return (x, y)\n        return (cen.x, cen.y)\n\n    for n, L in enumerate(LAYERS):\n        sk = root.sketches.add(plane_at(root, L[\"z0\"]))\n        sk.name = \"Layer %d\" % (n + 1)\n        sk.isComputeDeferred = True\n        lines = sk.sketchCurves.sketchLines\n        for p in L[\"polys\"]:\n            for ring in [p[\"outer\"]] + p[\"holes\"]:\n                pts = [P3(x, y, 0) for x, y in ring]\n                for i in range(len(pts)):\n                    lines.addByTwoPoints(pts[i], pts[(i + 1) % len(pts)])\n        sk.isComputeDeferred = False\n        keep = []\n        for prof in sk.profiles:\n            if solid_at(point_in(prof), L[\"polys\"]):\n                keep.append(prof)\n        if not keep:\n            raise RuntimeError(\"Layer %d came out empty.\" % (n + 1))\n        root.features.extrudeFeatures.addSimple(coll(keep), VI(L[\"h\"]), NEW if n == 0 else JOIN)\n", "params": {}, "formats": ["3mf", "stl", "step", "f3d"]}